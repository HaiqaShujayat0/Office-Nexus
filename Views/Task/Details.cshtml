@model OfficeNexus.Models.TaskItem

@{
    ViewData["Title"] = "Task Details";
    var isAdmin = User.IsInRole("Admin");
    var priorityColors = new Dictionary<OfficeNexus.Models.TaskPriority, string>
    {
        { OfficeNexus.Models.TaskPriority.Low, "bg-slate-100 text-slate-700 border-slate-300" },
        { OfficeNexus.Models.TaskPriority.Medium, "bg-blue-100 text-blue-700 border-blue-300" },
        { OfficeNexus.Models.TaskPriority.High, "bg-orange-100 text-orange-700 border-orange-300" },
        { OfficeNexus.Models.TaskPriority.Critical, "bg-red-100 text-red-700 border-red-300" }
    };
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 p-6">
    <div class="max-w-7xl mx-auto">
        
        <!-- Back Button -->
        <div class="mb-6">
            <a href="@(isAdmin ? Url.Action("Index", "Task") : Url.Action("MyTasks", "Task"))" 
               class="inline-flex items-center text-blue-600 hover:text-blue-700 font-semibold">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Back to Tasks
            </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Task Details Panel (Left - 2 columns) -->
            <div class="lg:col-span-2 bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden">
                <div class="bg-gradient-to-r from-blue-600 to-cyan-600 p-6 text-white">
                    <div class="flex items-start justify-between">
                        <div class="flex-1">
                            <h1 class="text-2xl font-bold mb-2">@Model.Title</h1>
                            <div class="flex flex-wrap gap-2">
                                <span class="px-3 py-1 rounded-full text-sm font-semibold @priorityColors[Model.Priority] border">
                                    @Model.Priority Priority
                                </span>
                                <span class="px-3 py-1 rounded-full text-sm font-semibold bg-white bg-opacity-20 backdrop-blur">
                                    @Model.Status
                                </span>
                            </div>
                        </div>
                        @if (isAdmin)
                        {
                            <div class="flex gap-2">
                                <a href="@Url.Action("Edit", "Task", new { id = Model.Id })" 
                                   class="bg-white bg-opacity-20 hover:bg-opacity-30 text-white px-4 py-2 rounded-lg transition-all">
                                    Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline"
                                      onsubmit="return confirm('Are you sure you want to delete this task?');">
                                    <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition-all">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>

                <div class="p-6 space-y-6">
                    <!-- Description -->
                    <div>
                        <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2">Description</h3>
                        <p class="text-slate-700 whitespace-pre-wrap">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
                    </div>

                    <!-- Task Info Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4 border-t border-slate-200">
                        <div>
                            <h3 class="text-sm font-semibold text-slate-500 mb-1">Assigned To</h3>
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-full flex items-center justify-center text-white font-bold">
                                    @Model.AssignedToUser.FullName.Substring(0, 1)
                                </div>
                                <div>
                                    <p class="font-semibold text-slate-900">@Model.AssignedToUser.FullName</p>
                                    <p class="text-xs text-slate-500">@Model.AssignedToUser.Department</p>
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="text-sm font-semibold text-slate-500 mb-1">Created By</h3>
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 bg-gradient-to-br from-purple-500 to-pink-600 rounded-full flex items-center justify-center text-white font-bold">
                                    @Model.CreatedByAdmin.FullName.Substring(0, 1)
                                </div>
                                <div>
                                    <p class="font-semibold text-slate-900">@Model.CreatedByAdmin.FullName</p>
                                    <p class="text-xs text-slate-500">@Model.CreatedAt.ToString("MMM dd, yyyy")</p>
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="text-sm font-semibold text-slate-500 mb-1">Due Date</h3>
                            <p class="text-slate-900 font-semibold">@Model.DueDate.ToString("MMMM dd, yyyy")</p>
                            @if (Model.DueDate < DateTime.Now && Model.Status != OfficeNexus.Models.TaskWorkflowStatus.Done)
                            {
                                <p class="text-red-600 text-sm font-semibold">Overdue</p>
                            }
                        </div>

                        @if (Model.CompletedAt.HasValue)
                        {
                            <div>
                                <h3 class="text-sm font-semibold text-slate-500 mb-1">Completed At</h3>
                                <p class="text-green-600 font-semibold">@Model.CompletedAt.Value.ToString("MMMM dd, yyyy")</p>
                            </div>
                        }
                    </div>

                    <!-- Attachment -->
                    @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                    {
                        <div class="pt-4 border-t border-slate-200">
                            <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2">Attachment</h3>
                            <a href="@Url.Action("DownloadAttachment", "Task", new { id = Model.Id })" 
                               class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 px-4 py-3 rounded-lg transition-all">
                                <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
                                </svg>
                                <span class="font-semibold text-slate-700">@(Model.AttachmentFileName ?? "Download Attachment")</span>
                            </a>
                        </div>
                    }

                    <!-- Status Update (Employee Only) -->
                    @if (!isAdmin && Model.Status != OfficeNexus.Models.TaskWorkflowStatus.Done)
                    {
                        <div class="pt-4 border-t border-slate-200">
                            <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-3">Update Status</h3>
                            <div class="flex flex-wrap gap-2">
                                @if (Model.Status != OfficeNexus.Models.TaskWorkflowStatus.ToDo)
                                {
                                    <form asp-action="UpdateStatus" method="post" class="inline">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="status" value="0" />
                                        <button type="submit" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-semibold transition-all">
                                            Move to To Do
                                        </button>
                                    </form>
                                }
                                @if (Model.Status != OfficeNexus.Models.TaskWorkflowStatus.InProgress)
                                {
                                    <form asp-action="UpdateStatus" method="post" class="inline">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="status" value="1" />
                                        <button type="submit" class="px-4 py-2 bg-blue-100 hover:bg-blue-200 text-blue-700 rounded-lg font-semibold transition-all">
                                            Move to In Progress
                                        </button>
                                    </form>
                                }
                                @if (Model.Status != OfficeNexus.Models.TaskWorkflowStatus.InReview)
                                {
                                    <form asp-action="UpdateStatus" method="post" class="inline">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="status" value="2" />
                                        <button type="submit" class="px-4 py-2 bg-yellow-100 hover:bg-yellow-200 text-yellow-700 rounded-lg font-semibold transition-all">
                                            Move to In Review
                                        </button>
                                    </form>
                                }
                            </div>
                            <p class="text-xs text-slate-500 mt-2">Note: Only administrators can mark tasks as Done.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Comments Panel (Right - 1 column) -->
            <div class="bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden flex flex-col" style="max-height: 800px;">
                <div class="p-4 border-b border-slate-200 bg-slate-50">
                    <h2 class="text-lg font-bold text-slate-900">Discussion</h2>
                    <p class="text-sm text-slate-600">@Model.Comments.Count comment@(Model.Comments.Count != 1 ? "s" : "")</p>
                </div>
                
                <!-- Comments List -->
                <div class="flex-1 overflow-y-auto p-4 space-y-4">
                    @if (Model.Comments.Any())
                    {
                        foreach (var comment in Model.Comments.OrderBy(c => c.PostedAt))
                        {
                            <div class="flex gap-3">
                                <div class="flex-shrink-0 w-8 h-8 bg-gradient-to-br from-purple-500 to-pink-600 rounded-full flex items-center justify-center text-white text-sm font-bold">
                                    @comment.User.FullName.Substring(0, 1)
                                </div>
                                <div class="flex-1">
                                    <div class="bg-slate-50 rounded-lg p-3">
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="font-semibold text-slate-900 text-sm">@comment.User.FullName</span>
                                            <span class="text-xs text-slate-500">@comment.PostedAt.ToString("MMM dd, h:mm tt")</span>
                                        </div>
                                        <p class="text-slate-700 text-sm whitespace-pre-wrap">@comment.Message</p>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-8 text-slate-400">
                            <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                            </svg>
                            <p>No comments yet. Start the discussion!</p>
                        </div>
                    }
                </div>

                <!-- Comment Input -->
                <div class="p-4 border-t border-slate-200 bg-slate-50">
                    <form asp-action="AddComment" method="post" class="flex gap-2">
                        <input type="hidden" name="taskId" value="@Model.Id" />
                        <input type="text" name="message" required maxlength="1000"
                               class="flex-1 px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                               placeholder="Type a comment...">
                        <button type="submit" class="bg-gradient-to-r from-blue-600 to-cyan-600 text-white px-6 py-2 rounded-lg font-semibold hover:shadow-lg transition-all">
                            Send
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="fixed top-4 right-4 bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg z-50">
        @TempData["Error"]
    </div>
}
