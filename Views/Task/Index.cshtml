@model IEnumerable<OfficeNexus.Models.TaskItem>

@{
    ViewData["Title"] = "Task Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 p-6">
    <div class="max-w-7xl mx-auto">
        
        <!-- Header -->
        <div class="mb-8 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-slate-900">Task Management</h1>
                <p class="text-slate-600 mt-1">Kanban Board - Manage and track all tasks</p>
            </div>
            <button onclick="document.getElementById('createTaskModal').classList.remove('hidden')" 
                    class="bg-gradient-to-r from-blue-600 to-cyan-600 text-white px-6 py-3 rounded-lg font-semibold shadow-lg hover:shadow-xl transition-all hover:scale-105">
                <svg class="w-5 h-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Create New Task
            </button>
        </div>

        <!-- Kanban Board -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            
            <!-- ToDo Column -->
            <div class="bg-white rounded-xl shadow-lg border-t-4 border-slate-400">
                <div class="p-4 border-b border-slate-200">
                    <h3 class="font-bold text-slate-700 flex items-center">
                        <span class="w-3 h-3 bg-slate-400 rounded-full mr-2"></span>
                        To Do
                        <span class="ml-auto bg-slate-100 text-slate-700 px-2 py-1 rounded-full text-xs font-semibold">
                            @Model.Count(t => t.Status == OfficeNexus.Models.TaskWorkflowStatus.ToDo)
                        </span>
                    </h3>
                </div>
                <div class="p-3 space-y-3 max-h-[calc(100vh-300px)] overflow-y-auto">
                    @foreach (var task in Model.Where(t => t.Status == OfficeNexus.Models.TaskWorkflowStatus.ToDo))
                    {
                        @await Html.PartialAsync("_TaskCard", task)
                    }
                </div>
            </div>

            <!-- InProgress Column -->
            <div class="bg-white rounded-xl shadow-lg border-t-4 border-blue-500">
                <div class="p-4 border-b border-slate-200">
                    <h3 class="font-bold text-blue-700 flex items-center">
                        <span class="w-3 h-3 bg-blue-500 rounded-full mr-2"></span>
                        In Progress
                        <span class="ml-auto bg-blue-100 text-blue-700 px-2 py-1 rounded-full text-xs font-semibold">
                            @Model.Count(t => t.Status == OfficeNexus.Models.TaskWorkflowStatus.InProgress)
                        </span>
                    </h3>
                </div>
                <div class="p-3 space-y-3 max-h-[calc(100vh-300px)] overflow-y-auto">
                    @foreach (var task in Model.Where(t => t.Status == OfficeNexus.Models.TaskWorkflowStatus.InProgress))
                    {
                        @await Html.PartialAsync("_TaskCard", task)
                    }
                </div>
            </div>

            <!-- InReview Column -->
            <div class="bg-white rounded-xl shadow-lg border-t-4 border-yellow-500">
                <div class="p-4 border-b border-slate-200">
                    <h3 class="font-bold text-yellow-700 flex items-center">
                        <span class="w-3 h-3 bg-yellow-500 rounded-full mr-2"></span>
                        In Review
                        <span class="ml-auto bg-yellow-100 text-yellow-700 px-2 py-1 rounded-full text-xs font-semibold">
                            @Model.Count(t => t.Status == OfficeNexus.Models.TaskWorkflowStatus.InReview)
                        </span>
                    </h3>
                </div>
                <div class="p-3 space-y-3 max-h-[calc(100vh-300px)] overflow-y-auto">
                    @foreach (var task in Model.Where(t => t.Status == OfficeNexus.Models.TaskWorkflowStatus.InReview))
                    {
                        @await Html.PartialAsync("_TaskCard", task)
                    }
                </div>
            </div>

            <!-- Done Column -->
            <div class="bg-white rounded-xl shadow-lg border-t-4 border-green-500">
                <div class="p-4 border-b border-slate-200">
                    <h3 class="font-bold text-green-700 flex items-center">
                        <span class="w-3 h-3 bg-green-500 rounded-full mr-2"></span>
                        Done
                        <span class="ml-auto bg-green-100 text-green-700 px-2 py-1 rounded-full text-xs font-semibold">
                            @Model.Count(t => t.Status == OfficeNexus.Models.TaskWorkflowStatus.Done)
                        </span>
                    </h3>
                </div>
                <div class="p-3 space-y-3 max-h-[calc(100vh-300px)] overflow-y-auto">
                    @foreach (var task in Model.Where(t => t.Status == OfficeNexus.Models.TaskWorkflowStatus.Done))
                    {
                        @await Html.PartialAsync("_TaskCard", task)
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Task Modal -->
<div id="createTaskModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
        <div class="p-6 border-b border-slate-200 flex items-center justify-between sticky top-0 bg-white">
            <h2 class="text-2xl font-bold text-slate-900">Create New Task</h2>
            <button onclick="document.getElementById('createTaskModal').classList.add('hidden')" 
                    class="text-slate-400 hover:text-slate-600 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="p-6 space-y-5">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Task Title *</label>
                <input type="text" name="Title" required maxlength="200"
                       class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                       placeholder="Enter task title">
            </div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Description</label>
                <textarea name="Description" rows="4" maxlength="2000"
                          class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                          placeholder="Enter task description"></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Assign To *</label>
                    <select name="AssignedToUserId" required
                            class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                        <option value="">Select Employee</option>
                        @foreach (var employee in ViewBag.Employees)
                        {
                            <option value="@employee.Id">@employee.FullName - @employee.Department</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Priority *</label>
                    <select name="Priority" required
                            class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                        <option value="1">Medium</option>
                        <option value="0">Low</option>
                        <option value="2">High</option>
                        <option value="3">Critical</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Due Date *</label>
                <input type="date" name="DueDate" required
                       min="@DateTime.Now.ToString("yyyy-MM-dd")"
                       class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
            </div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Attachment (Optional)</label>
                <input type="file" name="attachmentFile" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg"
                       class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                <p class="text-xs text-slate-500 mt-1">Max file size: 10MB. Allowed: PDF, DOC, DOCX, XLS, XLSX, PNG, JPG</p>
            </div>

            <div class="flex gap-3 pt-4">
                <button type="submit"
                        class="flex-1 bg-gradient-to-r from-blue-600 to-cyan-600 text-white py-3 rounded-lg font-semibold shadow-lg hover:shadow-xl transition-all hover:scale-105">
                    Create Task
                </button>
                <button type="button" onclick="document.getElementById('createTaskModal').classList.add('hidden')"
                        class="px-6 py-3 border-2 border-slate-300 text-slate-700 rounded-lg font-semibold hover:bg-slate-50 transition-all">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50 animate-fade-in">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="fixed top-4 right-4 bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg z-50 animate-fade-in">
        @TempData["Error"]
    </div>
}
