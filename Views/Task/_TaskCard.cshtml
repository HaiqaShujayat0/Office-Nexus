@model OfficeNexus.Models.TaskItem

@{
    var priorityColors = new Dictionary<OfficeNexus.Models.TaskPriority, string>
    {
        { OfficeNexus.Models.TaskPriority.Low, "bg-slate-100 text-slate-700" },
        { OfficeNexus.Models.TaskPriority.Medium, "bg-blue-100 text-blue-700" },
        { OfficeNexus.Models.TaskPriority.High, "bg-orange-100 text-orange-700" },
        { OfficeNexus.Models.TaskPriority.Critical, "bg-red-100 text-red-700" }
    };

    var priorityBorderColors = new Dictionary<OfficeNexus.Models.TaskPriority, string>
    {
        { OfficeNexus.Models.TaskPriority.Low, "border-l-slate-400" },
        { OfficeNexus.Models.TaskPriority.Medium, "border-l-blue-500" },
        { OfficeNexus.Models.TaskPriority.High, "border-l-orange-500" },
        { OfficeNexus.Models.TaskPriority.Critical, "border-l-red-500" }
    };

    var isOverdue = Model.DueDate < DateTime.Now && Model.Status != OfficeNexus.Models.TaskWorkflowStatus.Done;
}

<div class="bg-white border-l-4 @priorityBorderColors[Model.Priority] rounded-lg shadow hover:shadow-md transition-shadow p-4 cursor-pointer"
     onclick="window.location.href='@Url.Action("Details", "Task", new { id = Model.Id })'">
    
    <!-- Priority Badge -->
    <div class="flex items-center justify-between mb-2">
        <span class="px-2 py-1 rounded-full text-xs font-semibold @priorityColors[Model.Priority]">
            @Model.Priority
        </span>
        @if (!string.IsNullOrEmpty(Model.AttachmentPath))
        {
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
            </svg>
        }
    </div>

    <!-- Task Title -->
    <h4 class="font-semibold text-slate-900 mb-2 line-clamp-2">@Model.Title</h4>

    <!-- Task Description -->
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p class="text-sm text-slate-600 mb-3 line-clamp-2">@Model.Description</p>
    }

    <!-- Assignee -->
    <div class="flex items-center gap-2 mb-2">
        <div class="w-6 h-6 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-full flex items-center justify-center text-white text-xs font-bold">
            @Model.AssignedToUser.FullName.Substring(0, 1)
        </div>
        <span class="text-xs text-slate-600">@Model.AssignedToUser.FullName</span>
    </div>

    <!-- Due Date -->
    <div class="flex items-center gap-1 text-xs @(isOverdue ? "text-red-600 font-semibold" : "text-slate-500")">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <span>Due: @Model.DueDate.ToString("MMM dd, yyyy")</span>
        @if (isOverdue)
        {
            <span class="ml-1">(Overdue)</span>
        }
    </div>

    <!-- Comments Count -->
    @if (Model.Comments.Any())
    {
        <div class="mt-2 pt-2 border-t border-slate-100 flex items-center gap-1 text-xs text-slate-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
            <span>@Model.Comments.Count comment@(Model.Comments.Count != 1 ? "s" : "")</span>
        </div>
    }
</div>
