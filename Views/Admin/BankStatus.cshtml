@model OfficeNexus.ViewModels.BankAnalyticsDashboardViewModel
@{
    ViewData["Title"] = "Bank Status";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">
    
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-slate-900">Bank Info Compliance Report</h2>
            <p class="mt-1 text-sm text-slate-500">Track which employees have submitted their bank details for payroll</p>
        </div>
        <div class="flex gap-3">
            <button onclick="printReport()" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-300 text-slate-700 font-medium rounded-lg hover:bg-slate-50 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                Print Report
            </button>
        </div>
    </div>

    <!-- Analytics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Total Employees Card -->
        <div class="bg-white shadow-lg rounded-xl border border-slate-100 p-6 hover:shadow-xl transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500">Total Employees</p>
                    <p class="text-3xl font-bold text-slate-900 mt-2">@Model.TotalEmployees</p>
                    <p class="text-xs text-slate-400 mt-1">All active employees</p>
                </div>
                <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center">
                    <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Submitted Card -->
        <div class="bg-white shadow-lg rounded-xl border border-slate-100 p-6 hover:shadow-xl transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500">Submitted</p>
                    <p class="text-3xl font-bold text-green-600 mt-2">@Model.SubmittedCount</p>
                    <p class="text-xs text-green-600 mt-1">@(Model.TotalEmployees > 0 ? Math.Round((double)Model.SubmittedCount / Model.TotalEmployees * 100, 1) : 0)% compliance rate</p>
                </div>
                <div class="w-14 h-14 bg-green-100 rounded-xl flex items-center justify-center">
                    <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Pending Card -->
        <div class="bg-white shadow-lg rounded-xl border border-slate-100 p-6 hover:shadow-xl transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500">Pending</p>
                    <p class="text-3xl font-bold text-amber-600 mt-2">@Model.PendingCount</p>
                    <p class="text-xs text-amber-600 mt-1">Requires attention</p>
                </div>
                <div class="w-14 h-14 bg-amber-100 rounded-xl flex items-center justify-center">
                    <svg class="w-8 h-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart and List Row -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Compliance Pie Chart -->
        <div class="bg-white shadow-lg rounded-xl border border-slate-100 p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-slate-900">Compliance Status</h3>
                <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                </div>
            </div>
            <div class="h-64">
                <canvas id="bankComplianceChart"></canvas>
            </div>
        </div>

        <!-- Employee List -->
        <div class="bg-white shadow-lg rounded-xl border border-slate-100 p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-slate-900">Employee Status</h3>
                <div class="text-xs text-slate-500">
                    @Model.TotalEmployees employees
                </div>
            </div>
            <div class="overflow-y-auto max-h-64">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-700 uppercase tracking-wider">Name</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-700 uppercase tracking-wider">Department</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-700 uppercase tracking-wider">Status</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-700 uppercase tracking-wider">Action</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-slate-200">
                        @foreach (var employee in Model.EmployeeStatuses)
                        {
                            <tr class="hover:bg-slate-50 transition">
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <div class="text-sm font-medium text-slate-900">@employee.EmployeeName</div>
                                    <div class="text-xs text-slate-500">ID: @employee.EmployeeId</div>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <div class="text-sm text-slate-700">@employee.Department</div>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    @if (employee.HasSubmittedBankInfo)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                            </svg>
                                            Submitted
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                                            </svg>
                                            Pending
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    @if (!employee.HasSubmittedBankInfo)
                                    {
                                        <button onclick="sendReminder(@employee.EmployeeId)" class="text-xs px-3 py-1 bg-amber-100 text-amber-700 rounded-lg hover:bg-amber-200 transition font-medium">
                                            Send Reminder
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-400">Submitted @employee.SubmissionDate?.ToString("MMM dd, yyyy")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        .print-section, .print-section * {
            visibility: visible;
        }
        .print-section {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }
        .no-print {
            display: none !important;
        }
        .print-header {
            page-break-after: avoid;
            margin-bottom: 20px;
            border-bottom: 2px solid #000;
            padding-bottom: 15px;
        }
        .print-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        .print-table th,
        .print-table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        .print-table th {
            background-color: #f3f4f6;
            font-weight: bold;
        }
        .print-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        .print-stat-box {
            border: 1px solid #ddd;
            padding: 15px;
            text-align: center;
        }
        .print-stat-value {
            font-size: 24px;
            font-weight: bold;
            margin-top: 5px;
        }
        @@page {
            margin: 1cm;
        }
    }
</style>

@section Scripts {
    <script>
        // Bank Compliance Pie Chart
        const bankComplianceCtx = document.getElementById('bankComplianceChart').getContext('2d');
        const submittedCount = @Model.SubmittedCount;
        const pendingCount = @Model.PendingCount;
        
        new Chart(bankComplianceCtx, {
            type: 'pie',
            data: {
                labels: ['Submitted', 'Pending'],
                datasets: [{
                    data: [submittedCount, pendingCount],
                    backgroundColor: [
                        'rgb(16, 185, 129)', // Green for submitted
                        'rgb(245, 158, 11)'  // Amber for pending
                    ],
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 15,
                            font: {
                                size: 12
                            }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const label = context.label || '';
                                const value = context.parsed || 0;
                                const total = submittedCount + pendingCount;
                                const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                                return label + ': ' + value + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });

        // Send Reminder function (dummy implementation)
        function sendReminder(employeeId) {
            if (confirm('Send reminder email to this employee to submit their bank details?')) {
                // This is a placeholder - you can implement actual email sending later
                alert('Reminder email would be sent to employee ID: ' + employeeId + '\n\n(Feature to be implemented)');
            }
        }

        // Print Report function
        function printReport() {
            const printWindow = window.open('', '_blank');
            const printContent = `
                <!DOCTYPE html>
                <html>
                <head>
                    <title>Bank Info Compliance Report</title>
                    <style>
                        body {
                            font-family: Arial, sans-serif;
                            margin: 20px;
                            color: #000;
                        }
                        .print-header {
                            text-align: center;
                            margin-bottom: 30px;
                            border-bottom: 3px solid #000;
                            padding-bottom: 15px;
                        }
                        .print-header h1 {
                            margin: 0;
                            font-size: 24px;
                            font-weight: bold;
                        }
                        .print-header p {
                            margin: 5px 0 0 0;
                            font-size: 12px;
                            color: #666;
                        }
                        .print-date {
                            text-align: right;
                            margin-bottom: 20px;
                            font-size: 12px;
                        }
                        .print-stats {
                            display: grid;
                            grid-template-columns: repeat(3, 1fr);
                            gap: 15px;
                            margin-bottom: 30px;
                        }
                        .print-stat-box {
                            border: 2px solid #000;
                            padding: 15px;
                            text-align: center;
                            background-color: #f9f9f9;
                        }
                        .print-stat-label {
                            font-size: 12px;
                            font-weight: bold;
                            text-transform: uppercase;
                            margin-bottom: 5px;
                        }
                        .print-stat-value {
                            font-size: 28px;
                            font-weight: bold;
                            margin: 5px 0;
                        }
                        .print-stat-sub {
                            font-size: 11px;
                            color: #666;
                        }
                        .print-table {
                            width: 100%;
                            border-collapse: collapse;
                            margin-top: 20px;
                            page-break-inside: auto;
                        }
                        .print-table thead {
                            background-color: #f3f4f6;
                        }
                        .print-table th {
                            border: 1px solid #000;
                            padding: 10px;
                            text-align: left;
                            font-weight: bold;
                            font-size: 11px;
                            text-transform: uppercase;
                        }
                        .print-table td {
                            border: 1px solid #ddd;
                            padding: 8px;
                            font-size: 11px;
                        }
                        .print-table tr {
                            page-break-inside: avoid;
                        }
                        .status-submitted {
                            color: #16a34a;
                            font-weight: bold;
                        }
                        .status-pending {
                            color: #dc2626;
                            font-weight: bold;
                        }
                        @@page {
                            margin: 1.5cm;
                            size: A4;
                        }
                        @@media print {
                            .print-table {
                                page-break-inside: auto;
                            }
                            .print-table tr {
                                page-break-inside: avoid;
                                page-break-after: auto;
                            }
                        }
                    </style>
                </head>
                <body>
                    <div class="print-header">
                        <h1>Bank Info Compliance Report</h1>
                        <p>OfficeNexus - Employee Bank Details Submission Status</p>
                    </div>
                    <div class="print-date">
                        Generated on: ${new Date().toLocaleString()}
                    </div>
                    <div class="print-stats">
                        <div class="print-stat-box">
                            <div class="print-stat-label">Total Employees</div>
                            <div class="print-stat-value">@Model.TotalEmployees</div>
                            <div class="print-stat-sub">All active employees</div>
                        </div>
                        <div class="print-stat-box">
                            <div class="print-stat-label">Submitted</div>
                            <div class="print-stat-value" style="color: #16a34a;">@Model.SubmittedCount</div>
                            <div class="print-stat-sub">@(Model.TotalEmployees > 0 ? Math.Round((double)Model.SubmittedCount / Model.TotalEmployees * 100, 1) : 0)% compliance rate</div>
                        </div>
                        <div class="print-stat-box">
                            <div class="print-stat-label">Pending</div>
                            <div class="print-stat-value" style="color: #dc2626;">@Model.PendingCount</div>
                            <div class="print-stat-sub">Requires attention</div>
                        </div>
                    </div>
                    <table class="print-table">
                        <thead>
                            <tr>
                                <th>Employee ID</th>
                                <th>Name</th>
                                <th>Department</th>
                                <th>Status</th>
                                <th>Submission Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var employee in Model.EmployeeStatuses)
                            {
                                <tr>
                                    <td>@employee.EmployeeId</td>
                                    <td>@employee.EmployeeName</td>
                                    <td>@employee.Department</td>
                                    <td class="@(employee.HasSubmittedBankInfo ? "status-submitted" : "status-pending")">
                                        @(employee.HasSubmittedBankInfo ? "✓ Submitted" : "✗ Pending")
                                    </td>
                                    <td>@(employee.SubmissionDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </body>
                </html>
            `;
            
            printWindow.document.write(printContent);
            printWindow.document.close();
            printWindow.focus();
            setTimeout(() => {
                printWindow.print();
                printWindow.close();
            }, 250);
        }
    </script>
}

