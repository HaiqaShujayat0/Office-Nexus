@model OfficeNexus.Data.User

@{
    ViewData["Title"] = "Edit Employee";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-4xl mx-auto space-y-6">
    
    <!-- Header -->
    <div class="flex items-center gap-4">
        <a asp-action="EmployeeManagement" class="inline-flex items-center text-slate-600 hover:text-slate-900 transition">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back to Employee Management
        </a>
    </div>

    <div class="bg-white shadow-lg rounded-xl border border-slate-100 p-6">
        
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-2xl font-bold text-slate-900">Edit Employee</h2>
                <p class="mt-1 text-sm text-slate-500">Update employee information</p>
            </div>
            @if (Model.Status == OfficeNexus.Data.EmployeeStatus.Pending)
            {
                <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                    Pending
                </span>
            }
            else if (Model.Status == OfficeNexus.Data.EmployeeStatus.Active)
            {
                <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    Active
                </span>
            }
        </div>
        
        @if (TempData["Success"] != null) 
        { 
            <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg flex items-center gap-3">
                <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <p class="text-sm font-medium text-green-800">@TempData["Success"]</p>
            </div>
        }
        
        @if (TempData["Error"] != null) 
        { 
            <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg flex items-center gap-3">
                <svg class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
                <p class="text-sm font-medium text-red-800">@TempData["Error"]</p>
            </div>
        }

        <form asp-action="UpdateEmployee" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input type="hidden" name="id" value="@Model.Id" />
            
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Full Name *</label>
                <input 
                    type="text" 
                    name="fullName" 
                    value="@Model.FullName"
                    required 
                    placeholder="John Doe"
                    class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Email Address *</label>
                <input 
                    type="email" 
                    name="email" 
                    value="@Model.Email"
                    required 
                    placeholder="john.doe@company.com"
                    class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Job Title *</label>
                <input 
                    type="text" 
                    name="jobTitle" 
                    value="@Model.JobTitle"
                    required 
                    placeholder="Software Engineer"
                    class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Department *</label>
                <select 
                    name="department" 
                    required
                    class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
                    <option value="">Select Department</option>
                    <option value="IT" selected="@(Model.Department == "IT")">IT</option>
                    <option value="HR" selected="@(Model.Department == "HR")">HR</option>
                    <option value="Finance" selected="@(Model.Department == "Finance")">Finance</option>
                    <option value="Marketing" selected="@(Model.Department == "Marketing")">Marketing</option>
                    <option value="Sales" selected="@(Model.Department == "Sales")">Sales</option>
                    <option value="Operations" selected="@(Model.Department == "Operations")">Operations</option>
                    <option value="General" selected="@(Model.Department == "General")">General</option>
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Basic Salary *</label>
                <input 
                    type="number" 
                    name="basicSalary" 
                    value="@Model.BasicSalary"
                    required 
                    min="0"
                    step="0.01"
                    placeholder="30000"
                    class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Phone Number *</label>
                <input 
                    type="tel" 
                    name="phoneNumber" 
                    value="@Model.PhoneNumber"
                    required
                    placeholder="+1 (555) 123-4567"
                    pattern="[0-9+\-\(\)\s]+"
                    title="Please enter a valid phone number"
                    class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
                <p class="mt-1 text-xs text-slate-500">Include country code if international</p>
            </div>
            
            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-slate-700 mb-1">Home Address *</label>
                <textarea 
                    name="homeAddress" 
                    required
                    rows="2"
                    maxlength="500"
                    placeholder="123 Main Street, Apartment 4B, City, State, ZIP"
                    class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition resize-none">@Model.HomeAddress</textarea>
                <p class="mt-1 text-xs text-slate-500">Full residential address</p>
            </div>
            
            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-slate-700 mb-1">Password</label>
                <div class="relative">
                    <input 
                        type="password" 
                        id="editPassword"
                        name="password" 
                        minlength="8"
                        pattern=".*\d.*"
                        placeholder="Leave empty to keep current password"
                        class="w-full px-3 py-2 pr-10 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
                    <button type="button" onclick="togglePassword('editPassword')" class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none">
                        <svg id="editPassword-eye" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>
                <p class="mt-1 text-xs text-slate-500">Leave empty to keep current password. If provided, must be at least 8 characters with at least one digit.</p>
                <div id="editPassword-error" class="text-xs text-red-600 mt-1 hidden"></div>
            </div>
            
            <div class="md:col-span-2 flex justify-end gap-3 pt-4 border-t border-slate-200">
                <a 
                    asp-action="EmployeeManagement"
                    class="px-4 py-2 border border-slate-300 text-slate-700 font-medium rounded-lg hover:bg-slate-50 transition">
                    Cancel
                </a>
                <button 
                    type="submit" 
                    class="px-6 py-2 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-medium rounded-lg shadow-lg hover:shadow-xl transition-all">
                    Update Employee
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function togglePassword(inputId) {
        const input = document.getElementById(inputId);
        const eyeIcon = document.getElementById(inputId + '-eye');
        
        if (input.type === 'password') {
            input.type = 'text';
            eyeIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />';
        } else {
            input.type = 'password';
            eyeIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />';
        }
    }

    // Password validation for edit form
    document.addEventListener('DOMContentLoaded', function() {
        const editPasswordInput = document.getElementById('editPassword');
        const editPasswordError = document.getElementById('editPassword-error');
        const editForm = document.querySelector('form[asp-action="UpdateEmployee"]');
        
        if (editPasswordInput && editPasswordError) {
            editPasswordInput.addEventListener('input', function() {
                const password = editPasswordInput.value;
                
                // Only validate if password is provided (empty is allowed to keep current)
                if (password.length > 0) {
                    if (password.length < 8) {
                        editPasswordError.textContent = 'Password must be at least 8 characters long';
                        editPasswordError.classList.remove('hidden');
                        editPasswordInput.classList.add('border-red-500');
                    } else if (!/\d/.test(password)) {
                        editPasswordError.textContent = 'Password must contain at least one digit';
                        editPasswordError.classList.remove('hidden');
                        editPasswordInput.classList.add('border-red-500');
                    } else {
                        editPasswordError.classList.add('hidden');
                        editPasswordInput.classList.remove('border-red-500');
                    }
                } else {
                    editPasswordError.classList.add('hidden');
                    editPasswordInput.classList.remove('border-red-500');
                }
            });
        }
    });
</script>
