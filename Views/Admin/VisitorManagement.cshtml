@model dynamic

@{
    ViewData["Title"] = "Visitor Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6" x-data="{ openForm: false, searchQuery: '' }">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-slate-900">Visitor Management</h2>
            <p class="mt-1 text-sm text-slate-500">Log and track all office visitors across all employees</p>
        </div>
        <button 
            type="button" 
            @@click="openForm = !openForm" 
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-medium rounded-lg shadow-lg hover:shadow-xl transition-all duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
            <span x-text="openForm ? 'Close Form' : 'Log New Visitor'"></span>
        </button>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4 flex items-center gap-3">
            <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <p class="text-sm font-medium text-green-800">@TempData["Success"]</p>
        </div>
    }

    <!-- Add Visitor Form -->
    <div 
        x-show="openForm" 
        x-cloak 
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 transform scale-95"
        x-transition:enter-end="opacity-100 transform scale-100"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 transform scale-100"
        x-transition:leave-end="opacity-0 transform scale-95"
        class="bg-white shadow-lg rounded-xl border border-slate-100 p-6">
        
        <h3 class="text-lg font-semibold text-slate-900 mb-4">Log New Visitor</h3>
        
        <form asp-action="LogVisitor" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Visitor Name *</label>
                <input 
                    type="text" 
                    name="VisitorName" 
                    required 
                    placeholder="Enter full name"
                    class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Visitor Type *</label>
                <select 
                    name="VisitorType" 
                    class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
                    <option value="Outsider">Outsider (Client/Guest)</option>
                    <option value="Internal">Internal (Other Branch)</option>
                    <option value="Interview">Interview Candidate</option>
                    <option value="Delivery">Delivery Personnel</option>
                    <option value="Contractor">Contractor</option>
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Assigned Employee *</label>
                <select 
                    name="EmployeeId" 
                    required
                    class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
                    <option value="">Select Employee</option>
                    @foreach(var emp in Model.Employees)
                    {
                        <option value="@emp.Id">@emp.FullName (@emp.Department)</option>
                    }
                </select>
                <p class="mt-1 text-xs text-slate-500">Which employee is this visitor meeting with?</p>
            </div>

            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-slate-700 mb-1">Purpose of Visit *</label>
                <textarea 
                    name="Purpose" 
                    required 
                    rows="2"
                    placeholder="e.g., Meeting regarding Project X, Equipment delivery, etc."
                    class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition"></textarea>
            </div>

            <div class="md:col-span-2 flex justify-end gap-3">
                <button 
                    type="button"
                    @@click="openForm = false"
                    class="px-4 py-2 border border-slate-300 text-slate-700 font-medium rounded-lg hover:bg-slate-50 transition">
                    Cancel
                </button>
                <button 
                    type="submit" 
                    class="px-6 py-2 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-medium rounded-lg shadow-lg hover:shadow-xl transition-all">
                    Log Visitor
                </button>
            </div>
        </form>
    </div>

    <!-- Search Bar -->
    <div class="bg-white shadow-sm rounded-xl border border-slate-100 p-4">
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <input 
                type="text" 
                x-model="searchQuery"
                placeholder="Search visitors by name or purpose..."
                class="block w-full pl-10 pr-3 py-2.5 border border-slate-300 rounded-lg leading-5 bg-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
        </div>
    </div>

    <!-- Visitor List -->
    <div class="bg-white shadow-lg rounded-xl border border-slate-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-slate-900">All Visitors (@Model.Visitors.Count)</h3>
                <span class="text-sm text-slate-500">Recent 50 entries</span>
            </div>
        </div>
        
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Visitor</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Purpose</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Type</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Employee</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Time In</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Status</th>
                        <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-200">
                    @foreach(var visitor in Model.Visitors)
                    {
                        <tr 
                            x-show="searchQuery === '' || '@visitor.VisitorName.ToLower()'.includes(searchQuery.toLowerCase()) || '@visitor.Purpose.ToLower()'.includes(searchQuery.toLowerCase())"
                            class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0 h-10 w-10">
                                        <div class="h-10 w-10 rounded-full bg-gradient-to-br from-blue-500 to-cyan-600 flex items-center justify-center text-white font-semibold shadow-md">
                                            @visitor.VisitorName.Substring(0, Math.Min(2, visitor.VisitorName.Length)).ToUpper()
                                        </div>
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-medium text-slate-900">@visitor.VisitorName</div>
                                        <div class="text-xs text-slate-500">ID: #@visitor.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-slate-900 max-w-xs truncate">@visitor.Purpose</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (visitor.VisitorType == "Outsider")
                                {
                                    <span class="px-2 py-1 inline-flex text-xs font-medium rounded-md bg-purple-50 text-purple-700">Outsider</span>
                                }
                                else if (visitor.VisitorType == "Internal")
                                {
                                    <span class="px-2 py-1 inline-flex text-xs font-medium rounded-md bg-blue-50 text-blue-700">Internal</span>
                                }
                                else if (visitor.VisitorType == "Interview")
                                {
                                    <span class="px-2 py-1 inline-flex text-xs font-medium rounded-md bg-amber-50 text-amber-700">Interview</span>
                                }
                                else
                                {
                                    <span class="px-2 py-1 inline-flex text-xs font-medium rounded-md bg-slate-50 text-slate-700">@visitor.VisitorType</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-slate-900">@visitor.Employee?.FullName</div>
                                <div class="text-xs text-slate-500">@visitor.Employee?.Department</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-slate-900">@visitor.TimeIn.ToString("MMM dd, yyyy")</div>
                                <div class="text-xs text-slate-500">@visitor.TimeIn.ToString("hh:mm tt")</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (visitor.TimeOut == null)
                                {
                                    <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                        On Premise
                                    </span>
                                }
                                else
                                {
                                    <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-slate-100 text-slate-800">
                                        Checked Out
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                @if (visitor.TimeOut == null)
                                {
                                    <form asp-action="CheckOutVisitor" method="POST" class="inline">
                                        <input type="hidden" name="id" value="@visitor.Id" />
                                        <button type="submit" class="text-indigo-600 hover:text-indigo-900">Check Out</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-slate-400">@visitor.TimeOut?.ToString("hh:mm tt")</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
            @if(Model.Visitors.Count == 0)
            {
                <div class="text-center py-12">
                    <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-slate-900">No visitors</h3>
                    <p class="mt-1 text-sm text-slate-500">Get started by logging your first visitor.</p>
                    <div class="mt-6">
                        <button 
                            @@click="openForm = true"
                            class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
                            <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                            </svg>
                            Log Visitor
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
