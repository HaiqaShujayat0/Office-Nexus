@model OfficeNexus.Models.LeaveRequest

@{
    ViewData["Title"] = "Apply for Leave";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
}

<div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-900">Apply for Leave</h2>
        <p class="mt-1 text-sm text-slate-500">Submit your leave request for approval</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white shadow-lg rounded-xl border border-slate-100 p-6">
        <form asp-action="Apply" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            
            <!-- Validation Summary -->
            <div asp-validation-summary="All" class="text-red-600 text-sm"></div>
            
            <!-- Date Range -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="StartDate" class="block text-sm font-medium text-slate-700 mb-1">
                        Start Date <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="StartDate" 
                           type="date" 
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                           required />
                    <span asp-validation-for="StartDate" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="EndDate" class="block text-sm font-medium text-slate-700 mb-1">
                        End Date <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="EndDate" 
                           type="date" 
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                           required />
                    <span asp-validation-for="EndDate" class="text-red-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <!-- Leave Type -->
            <div>
                <label asp-for="Type" class="block text-sm font-medium text-slate-700 mb-1">
                    Leave Type <span class="text-red-500">*</span>
                </label>
                <select asp-for="Type" 
                        class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                        required>
                    <option value="0">Sick Leave</option>
                    <option value="1" selected>Casual Leave</option>
                    <option value="2">Emergency Leave</option>
                </select>
                <span asp-validation-for="Type" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Reason -->
            <div>
                <label asp-for="Reason" class="block text-sm font-medium text-slate-700 mb-1">
                    Reason <span class="text-red-500">*</span>
                </label>
                <textarea asp-for="Reason" 
                          rows="4" 
                          placeholder="Please provide a brief reason for your leave request..."
                          class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                          required></textarea>
                <span asp-validation-for="Reason" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Info Box -->
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                <div class="flex gap-3">
                    <svg class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                    </svg>
                    <div class="text-sm text-blue-800">
                        <p class="font-medium mb-1">Important Information</p>
                        <ul class="list-disc list-inside space-y-1 text-blue-700">
                            <li>Start date cannot be in the past</li>
                            <li>End date must be same as or after start date</li>
                            <li>Your request will be reviewed by the admin</li>
                            <li>Check "My Leaves" to track your request status</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex justify-end gap-3 pt-4 border-t border-slate-200">
                <a asp-action="MyLeaves" 
                   class="px-4 py-2 border border-slate-300 text-slate-700 font-medium rounded-lg hover:bg-slate-50 transition">
                    Cancel
                </a>
                <button type="submit" 
                        class="px-6 py-2 bg-gradient-to-r from-blue-600 to-cyan-600 text-white font-medium rounded-lg shadow-lg hover:shadow-xl transition-all">
                    Submit Request
                </button>
            </div>
        </form>
    </div>
</div>
