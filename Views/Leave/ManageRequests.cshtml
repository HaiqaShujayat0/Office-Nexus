@model IEnumerable<OfficeNexus.Models.LeaveRequest>

@{
    ViewData["Title"] = "Manage Leave Requests";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var quotaData = ViewBag.QuotaData as Dictionary<int, int>;
}

<div class="space-y-6">
    <!-- Header -->
    <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-900">Manage Leave Requests</h2>
        <p class="mt-1 text-sm text-slate-500">Review and process pending leave applications</p>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4 flex items-center gap-3">
            <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <p class="text-sm font-medium text-green-800">@TempData["Success"]</p>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 flex items-center gap-3">
            <svg class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
            <p class="text-sm font-medium text-red-800">@TempData["Error"]</p>
        </div>
    }

    <!-- Pending Requests -->
    @if (Model.Any())
    {
        <div class="grid grid-cols-1 gap-6">
            @foreach (var request in Model)
            {
                var approvedCount = quotaData != null && quotaData.ContainsKey(request.Id) ? quotaData[request.Id] : 0;
                var quotaExceeded = approvedCount >= 2;

                <div class="bg-white shadow-lg rounded-xl border border-slate-100 overflow-hidden hover:shadow-xl transition-shadow">
                    <div class="p-6">
                        <!-- Header with Employee Info and Quota Badge -->
                        <div class="flex items-start justify-between mb-4">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-semibold shadow-md">
                                    @request.Employee.FullName.Substring(0, Math.Min(2, request.Employee.FullName.Length)).ToUpper()
                                </div>
                                <div>
                                    <h3 class="text-lg font-semibold text-slate-900">@request.Employee.FullName</h3>
                                    <p class="text-sm text-slate-500">@request.Employee.Department</p>
                                </div>
                            </div>
                            
                            <!-- Quota Badge -->
                            @if (quotaExceeded)
                            {
                                <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-red-100 text-red-800 border border-red-200">
                                    <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                    </svg>
                                    Quota Exceeded (@approvedCount leaves this month)
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200">
                                    <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                    Within Quota (@approvedCount leaves this month)
                                </span>
                            }
                        </div>

                        <!-- Leave Details -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4 p-4 bg-slate-50 rounded-lg">
                            <div>
                                <p class="text-xs font-medium text-slate-500 uppercase mb-1">Dates</p>
                                <p class="text-sm font-semibold text-slate-900">
                                    @request.StartDate.ToString("MMM dd") - @request.EndDate.ToString("MMM dd, yyyy")
                                </p>
                                <p class="text-xs text-slate-500">@((request.EndDate - request.StartDate).Days + 1) day(s)</p>
                            </div>
                            <div>
                                <p class="text-xs font-medium text-slate-500 uppercase mb-1">Type</p>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                                    @(request.Type == OfficeNexus.Models.LeaveType.Sick ? "bg-red-100 text-red-800" : 
                                      request.Type == OfficeNexus.Models.LeaveType.Casual ? "bg-blue-100 text-blue-800" : 
                                      "bg-orange-100 text-orange-800")">
                                    @request.Type
                                </span>
                            </div>
                            <div>
                                <p class="text-xs font-medium text-slate-500 uppercase mb-1">Requested On</p>
                                <p class="text-sm text-slate-900">@request.RequestedOn.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>

                        <!-- Reason -->
                        <div class="mb-4">
                            <p class="text-xs font-medium text-slate-500 uppercase mb-1">Reason</p>
                            <p class="text-sm text-slate-900">@request.Reason</p>
                        </div>

                        <!-- Action Form -->
                        <form asp-action="ProcessLeave" method="post" class="border-t border-slate-200 pt-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@request.Id" />
                            
                            <!-- Admin Remarks -->
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-slate-700 mb-2">
                                    Admin Remarks (Optional)
                                </label>
                                <textarea name="remarks" 
                                          rows="2" 
                                          placeholder="Add any comments or reasons for your decision..."
                                          class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm"></textarea>
                            </div>

                            <!-- Three Action Buttons -->
                            <div class="flex flex-wrap gap-3">
                                <button type="submit" 
                                        name="decision" 
                                        value="Paid"
                                        class="flex-1 min-w-[150px] inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 shadow-md hover:shadow-lg transition-all">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    Approve (Paid)
                                </button>

                                <button type="submit" 
                                        name="decision" 
                                        value="Unpaid"
                                        class="flex-1 min-w-[150px] inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-orange-500 text-white font-medium rounded-lg hover:bg-orange-600 shadow-md hover:shadow-lg transition-all">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    Approve (Unpaid)
                                </button>

                                <button type="submit" 
                                        name="decision" 
                                        value="Reject"
                                        class="flex-1 min-w-[150px] inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-red-600 text-white font-medium rounded-lg hover:bg-red-700 shadow-md hover:shadow-lg transition-all">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    Reject
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="bg-white shadow-lg rounded-xl border border-slate-100 p-12 text-center">
            <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <h3 class="mt-2 text-sm font-medium text-slate-900">No pending requests</h3>
            <p class="mt-1 text-sm text-slate-500">All leave requests have been processed.</p>
        </div>
    }

    <!-- History Section -->
    @{
        var processedRequests = ViewBag.ProcessedRequests as List<OfficeNexus.Models.LeaveRequest>;
    }

    @if (processedRequests != null && processedRequests.Any())
    {
        <div class="mt-12">
            <!-- History Header -->
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h3 class="text-xl font-bold text-slate-900">Processing History</h3>
                    <p class="mt-1 text-sm text-slate-500">Recently processed leave requests (last 50)</p>
                </div>
                <form asp-action="ClearHistory" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" 
                            onclick="return confirm('Are you sure you want to clear all history? This action cannot be undone.')"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-red-600 text-white font-medium rounded-lg hover:bg-red-700 shadow-md hover:shadow-lg transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        Clear History
                    </button>
                </form>
            </div>

            <!-- History Table -->
            <div class="bg-white shadow-lg rounded-xl border border-slate-100 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200">
                        <thead class="bg-slate-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Employee</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Dates</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Type</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Status</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Approval Type</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Remarks</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-slate-200">
                            @foreach (var request in processedRequests)
                            {
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center">
                                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-xs font-semibold">
                                                @request.Employee.FullName.Substring(0, Math.Min(2, request.Employee.FullName.Length)).ToUpper()
                                            </div>
                                            <div class="ml-3">
                                                <p class="text-sm font-medium text-slate-900">@request.Employee.FullName</p>
                                                <p class="text-xs text-slate-500">@request.Employee.Department</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm text-slate-900">
                                            @request.StartDate.ToString("MMM dd") - @request.EndDate.ToString("MMM dd, yyyy")
                                        </div>
                                        <div class="text-xs text-slate-500">
                                            @((request.EndDate - request.StartDate).Days + 1) day(s)
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                                            @(request.Type == OfficeNexus.Models.LeaveType.Sick ? "bg-red-100 text-red-800" : 
                                              request.Type == OfficeNexus.Models.LeaveType.Casual ? "bg-blue-100 text-blue-800" : 
                                              "bg-orange-100 text-orange-800")">
                                            @request.Type
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @if (request.Status == OfficeNexus.Models.LeaveStatus.Approved)
                                        {
                                            <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                                </svg>
                                                Approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                                </svg>
                                                Rejected
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @if (request.Status == OfficeNexus.Models.LeaveStatus.Approved)
                                        {
                                            @if (request.IsUnpaid)
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                                    Unpaid
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                    Paid
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-sm text-slate-400">-</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (!string.IsNullOrEmpty(request.AdminRemarks))
                                        {
                                            <div class="text-sm text-slate-600 max-w-xs truncate" title="@request.AdminRemarks">
                                                @request.AdminRemarks
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-sm text-slate-400">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
