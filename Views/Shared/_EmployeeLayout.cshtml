<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OfficeNexus</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Initialize dark mode from localStorage on page load
        (function() {
            const darkMode = localStorage.getItem('darkMode') === 'true';
            if (darkMode) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        [x-cloak] { display: none !important; }
        
        /* Smooth transitions */
        * {
            transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
        }
        
        /* Sidebar animations */
        .sidebar-link {
            transition: all 0.2s ease;
        }
        
        .sidebar-link:hover {
            transform: translateX(4px);
        }
        
        /* Gradient backgrounds */
        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-900 dark:to-slate-800 text-slate-800 dark:text-slate-100 antialiased" x-data="{ sidebarOpen: true, mobileMenuOpen: false }">
    
    <div class="flex h-screen overflow-hidden">
        
        <!-- Sidebar -->
        <aside 
            class="fixed inset-y-0 left-0 z-50 bg-white dark:bg-slate-800 border-r border-slate-200 dark:border-slate-700 transform transition-all duration-300 ease-in-out lg:translate-x-0 lg:static lg:inset-0"
            :class="{
                'w-64': sidebarOpen,
                'w-20': !sidebarOpen,
                '-translate-x-full lg:translate-x-0': !mobileMenuOpen
            }"
            x-cloak>
            
            <!-- Logo -->
            <div class="flex items-center justify-between h-16 px-6 border-b border-slate-200 bg-gradient-to-r from-blue-600 to-cyan-600">
                <div class="flex items-center gap-3 overflow-hidden">
                    <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center shadow-lg flex-shrink-0">
                        <span class="text-blue-600 text-xl font-bold">O</span>
                    </div>
                    <span class="font-bold text-lg text-white tracking-tight whitespace-nowrap" x-show="sidebarOpen" x-cloak>OfficeNexus</span>
                </div>
                <button 
                    @@click="sidebarOpen = !sidebarOpen"
                    class="hidden lg:block p-1.5 rounded-lg hover:bg-white hover:bg-opacity-20 text-white transition-all flex-shrink-0"
                    title="Toggle Sidebar">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
            
            <!-- User Profile -->
            <div class="p-4 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900">
                <div class="flex items-center gap-3 justify-center" :class="{'flex-col': !sidebarOpen}">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-cyan-600 flex items-center justify-center text-white font-semibold shadow-md flex-shrink-0">
                        @(User.Identity?.Name?.Substring(0, 2).ToUpper() ?? "EM")
                    </div>
                    <div class="flex-1 min-w-0" x-show="sidebarOpen" x-cloak>
                        <p class="text-sm font-semibold text-slate-900 dark:text-slate-100 truncate">@User.Identity?.Name</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 truncate">Employee</p>
                    </div>
                </div>
            </div>
            
            <!-- Navigation -->
            <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
                <a asp-controller="Employee" asp-action="Dashboard" 
                   class="sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300" : "text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700")"
                   :class="{'justify-center': !sidebarOpen}"
                   :title="!sidebarOpen ? 'Dashboard' : ''">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                    <span x-show="sidebarOpen" x-cloak>Dashboard</span>
                </a>
                
                <a asp-controller="Task" asp-action="MyTasks" 
                   class="sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Task" ? "bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300" : "text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700")"
                   :class="{'justify-center': !sidebarOpen}"
                   :title="!sidebarOpen ? 'My Tasks' : ''">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                    </svg>
                    <span x-show="sidebarOpen" x-cloak>My Tasks</span>
                </a>
                
                <a asp-controller="Leave" asp-action="MyLeaves" 
                   class="sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Leave" ? "bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300" : "text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700")"
                   :class="{'justify-center': !sidebarOpen}"
                   :title="!sidebarOpen ? 'My Leaves' : ''">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span x-show="sidebarOpen" x-cloak>My Leaves</span>
                </a>
                
                <a asp-controller="Employee" asp-action="Profile" 
                   class="sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300" : "text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700")"
                   :class="{'justify-center': !sidebarOpen}"
                   :title="!sidebarOpen ? 'My Profile' : ''">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span x-show="sidebarOpen" x-cloak>My Profile</span>
                </a>
                
                <a asp-controller="Employee" asp-action="BankDetails" 
                   class="sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-lg @(ViewContext.RouteData.Values["Action"]?.ToString() == "BankDetails" ? "bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300" : "text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700")"
                   :class="{'justify-center': !sidebarOpen}"
                   :title="!sidebarOpen ? 'Bank Details' : ''">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                    <span x-show="sidebarOpen" x-cloak>Bank Details</span>
                </a>
            </nav>
            
            <!-- Logout -->
            <div class="p-3 border-t border-slate-200 dark:border-slate-700">
                <a asp-controller="Auth" asp-action="Logout" 
                   class="sidebar-link flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 rounded-lg"
                   :class="{'justify-center': !sidebarOpen}"
                   :title="!sidebarOpen ? 'Sign Out' : ''">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    <span x-show="sidebarOpen" x-cloak>Sign Out</span>
                </a>
            </div>
        </aside>
        
        <!-- Mobile menu overlay -->
        <div 
            x-show="mobileMenuOpen" 
            x-cloak
            @@click="mobileMenuOpen = false"
            class="fixed inset-0 z-40 bg-slate-900 bg-opacity-50 lg:hidden"
            x-transition:enter="transition-opacity ease-linear duration-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition-opacity ease-linear duration-300"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0">
        </div>
        
        <!-- Main Content -->
        <div class="flex flex-col flex-1 overflow-hidden">
            
            <!-- Top Bar -->
            <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 shadow-sm z-10">
                <div class="flex items-center justify-between h-16 px-4 sm:px-6 lg:px-8">
                    <div class="flex items-center gap-4">
                        <button 
                            @@click="mobileMenuOpen = !mobileMenuOpen"
                            class="lg:hidden p-2 rounded-md text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                        </button>
                        <h1 class="text-xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">@(ViewData["Title"] ?? "Page")</h1>
                    </div>
                    
                    <div class="flex items-center gap-4">
                        <div class="hidden sm:flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
                            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <span class="font-medium">Online</span>
                        </div>
                        
                        <!-- Notification Bell Icon -->
                        @await Component.InvokeAsync("Notification")
                        
                        <div class="text-sm text-slate-500 dark:text-slate-400">
                            @DateTime.Now.ToString("MMM dd, yyyy")
                        </div>
                    </div>
                </div>
            </header>
            
            <!-- Page Content -->
            <main class="flex-1 overflow-y-auto bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-900 dark:to-slate-800">
                <div class="px-4 py-6 sm:px-6 lg:px-8 max-w-7xl mx-auto">
                    @RenderBody()
                </div>
            </main>
            
            <!-- Footer -->
            <footer class="bg-white dark:bg-slate-800 border-t border-slate-200 dark:border-slate-700 py-4">
                <div class="px-4 sm:px-6 lg:px-8 text-center text-sm text-slate-500 dark:text-slate-400">
                    &copy; 2025 OfficeNexus. All rights reserved.
                </div>
            </footer>
        </div>
    </div>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
